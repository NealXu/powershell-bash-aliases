# PowerShell Bash-Aliases .gitignore

# CodeGraph MCP index directory
.codegraph/

# Claude Code working directory
.claude/

# Test temporary files (at root level only)
/test-*.txt
/test-*.ps1
/debug-*.ps1
test-*-temp/
test-*-params/

# 曾经误提交过的测试/开发残留(--help 空文件、tee-test.txt),防止再次进入版本库
/--help
/tee-*.txt

# Pester test result files
test-results*.xml
test-failures*.xml

# Allow test files in tests/ directory
!tests/

# PowerShell session and profile backups
*.ps1.bak
*.psm1.bak

# Windows thumbnails
Thumbs.db

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Logs
*.log