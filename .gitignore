# PowerShell Bash-Aliases .gitignore

# CodeGraph MCP index directory
.codegraph/

# Test temporary files (at root level only)
/test-*.txt
/test-*.ps1
test-*-temp/
test-*-params/

# Allow test files in tests/ directory
!tests/

# PowerShell session and profile backups
*.ps1.bak
*.psm1.bak

# Windows thumbnails
Thumbs.db

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Logs
*.log